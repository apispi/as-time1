#!/bin/bash
#================================================================
# Copyright © 2026 ApiSpi
#
# Settings for cx.sh (the LOCAL assistant). Copy to vars.sh and adjust:
#
#   cp vars.sh.example vars.sh
#
# vars.sh is gitignored, so host and account details stay out of the repo.
#================================================================

PROJECT="time.apispi.com"            # directory under ~/www/ on the server

# The SSH destination. An alias from ~/.ssh/config is simplest (it carries
# the user, host and port); "user@host" works too, with the port on APP_SSH.
REMOTE="your-ssh-alias"
APP_SSH="ssh -x"                     # e.g. "ssh -x -p 18765" without an alias

# App root on the server, relative to ~. deploy.sh, .env and storage/ live here.
REMOTE_APP="www/$PROJECT"

# What the health checks (30, 38) request.
APP_URL="https://$PROJECT"

# If the site is behind HTTP password protection, "user:password" here lets
# the health checks through. Leave empty otherwise.
HTTP_AUTH=""
